  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.0",
    "@types/oracledb": "7.0.3",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.0",
    "typescript": "5.7.3",
    "vitest": "3.0.0"
  }
