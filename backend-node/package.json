{
  "name": "nutria-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "NUTRIA - Backend Node.js. Dominios: Seguridad y Afiliados.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/app/server.js",
  "scripts": {
